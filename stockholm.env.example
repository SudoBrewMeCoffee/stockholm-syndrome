# Copy to stockholm.env. One KEY=value per line, no quotes.
STOCK_COUNTRY=uk
STOCK_PRODUCT=iphone-duo
# Postcode: Apple returns its 12 nearest stores for it. Optional second postcode polled every 3rd cycle.
STOCK_LOCATION=W1B 5AH
STOCK_LOCATION2=
# Store IDs to watch, priority order. Run `python3 stockholm.py --once` with STOCK_STORES empty to list them.
STOCK_STORES=R092:Regent Street,R245:Covent Garden,R762:Battersea,R226:White City,R163:Brent Cross
# Alerts. ntfy: install the app, subscribe to a hard-to-guess topic. iMessage: macOS Messages signed in.
STOCK_NTFY_TOPIC=
STOCK_IMESSAGE_TO=
# When to stop and uninstall (local time, ISO).
STOCK_RUN_UNTIL=2026-10-24T23:59
